# Module 4 on a Linux server with a local GPU (16 GB class, e.g. RTX 4080).
#
# Copy to .env next to this file, then adjust the four values marked "change me"
# once the real host name and model tag are known. The application refuses to
# start with ENVIRONMENT=production while the local identity fallbacks below are
# still switched on, because those hand any caller another user's account.

APP_NAME=fortune-module4
ENVIRONMENT=production
MODULE4_DEBUG=false
API_PREFIX=/api/v1

# PostgreSQL + pgvector (docker-compose.yml provides one on 5432).
# SQLite is fine for a single reader but serializes writes, so the server uses Postgres.
DATABASE_URL=postgresql+psycopg://fortune:fortune@127.0.0.1:5432/fortune_module4
AUTO_CREATE_TABLES=false

# Accounts. Every private call must carry a session token from /api/v1/auth/login.
# DEV_USER_ID and X-User-Id stay available for local development only.
DEV_USER_ID=disabled
REQUIRE_USER_HEADER=true
ALLOW_LEGACY_USER_HEADER=false
AUTH_SESSION_DAYS=30

# Embeddings run on the GPU: BGE-M3 is 1024-dimensional, which is also the
# pgvector column width, so switching providers later means re-embedding.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Explanations run through a local OpenAI-compatible server (Ollama or vLLM).
# change me: the model tag that fits the card, for example a 14B instruct model
# at 4-bit (~9 GB) rather than the 27B Q8 build used on the Mac (~30 GB).
LLM_PROVIDER=openai_compatible
LLM_MODEL=qwen3.8:14b-q4_K_M
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=120
# Reasoning models otherwise spend the whole budget thinking before answering.
LLM_REASONING_EFFORT=none

CASE_SIMILARITY_THRESHOLD=0.60

# change me: the browser origin that reaches the Next.js app, not the API port.
CORS_ORIGINS=https://your-server-host
