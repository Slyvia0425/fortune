APP_NAME=fortune-module4
ENVIRONMENT=development
MODULE4_DEBUG=true
API_PREFIX=/api/v1

# This mode expects an SSH tunnel on 127.0.0.1:11434 to the MacBook Ollama.
DATABASE_URL=sqlite:///./module4.db
AUTO_CREATE_TABLES=true

DEV_USER_ID=dev-user
REQUIRE_USER_HEADER=false
ALLOW_LEGACY_USER_HEADER=true
AUTH_SESSION_DAYS=30

# Portable fallback. Change to sentence-transformers if the ML extra is installed.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

LLM_PROVIDER=openai_compatible
LLM_MODEL=qwen3.8:27b-q8_0
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=600
LLM_REASONING_EFFORT=none

CASE_SIMILARITY_THRESHOLD=0.60

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
