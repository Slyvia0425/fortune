APP_NAME=fortune-module4
ENVIRONMENT=development
MODULE4_DEBUG=true
API_PREFIX=/api/v1

# Linux/macOS local mode works without Docker or a GPU.
DATABASE_URL=sqlite:///./module4.db
AUTO_CREATE_TABLES=true

DEV_USER_ID=dev-user
REQUIRE_USER_HEADER=false
ALLOW_LEGACY_USER_HEADER=true
AUTH_SESSION_DAYS=30

# Deterministic local fallback. Install the GPU/ML extra for sentence-transformers.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Template is the portable default. Use remote_mac_qwen.env.example for Qwen.
LLM_PROVIDER=template
LLM_MODEL=qwen3.8:27b
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=600
LLM_REASONING_EFFORT=none

CASE_SIMILARITY_THRESHOLD=0.60

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
