APP_NAME=fortune-module4
ENVIRONMENT=development
MODULE4_DEBUG=true
API_PREFIX=/api/v1

# The default Windows setup uses SQLite so the service starts without Docker.
DATABASE_URL=sqlite:///./module4.db
AUTO_CREATE_TABLES=true

DEV_USER_ID=dev-user
REQUIRE_USER_HEADER=false
ALLOW_LEGACY_USER_HEADER=true
AUTH_SESSION_DAYS=30

# Local deterministic fallback. Switch to sentence-transformers for GPU embeddings.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Local template fallback. Point this to vLLM, Ollama, or LM Studio for GPU generation.
LLM_PROVIDER=template
LLM_MODEL=qwen3.8:27b
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=600
# Set to none when a Qwen3 thinking model is served through Ollama's OpenAI API.
LLM_REASONING_EFFORT=none

CASE_SIMILARITY_THRESHOLD=0.60

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
