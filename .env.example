# Combined deterministic Python service. It exposes both /bazi/chart and
# /divination/cast from python_algorithm/app.py.
PYTHON_ALGORITHM_BASE_URL=http://127.0.0.1:8000

# Optional service-specific overrides for deployments that run Bazi and
# divination as separate processes. They take precedence when set.
# PYTHON_BAZI_BASE_URL=http://127.0.0.1:8001
# PYTHON_DIVINATION_BASE_URL=http://127.0.0.1:8002

# Optional OpenAI-compatible LLM used only to understand natural-language
# divination requests. It never calculates a hexagram; Python remains the
# deterministic calculation engine. Keep the key server-only (no NEXT_PUBLIC_).
# API root or a complete /chat/completions endpoint are both accepted.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_server_side_key
# LLM_MODEL=gpt-4.1-mini

# Server-only Module 4 API used for authentication and private user data.
# Do not expose this internal service URL through NEXT_PUBLIC_ variables.
MODULE4_API_BASE_URL=http://127.0.0.1:8003
