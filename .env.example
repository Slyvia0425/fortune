# Combined deterministic Python service. It exposes both /bazi/chart and
# /divination/cast from python_algorithm/app.py.
PYTHON_ALGORITHM_BASE_URL=http://127.0.0.1:8000

# Optional service-specific overrides for deployments that run Bazi and
# divination as separate processes. They take precedence when set.
# PYTHON_BAZI_BASE_URL=http://127.0.0.1:8001
# PYTHON_DIVINATION_BASE_URL=http://127.0.0.1:8002

# Optional OpenAI-compatible LLM used to understand natural-language
# divination requests and paraphrase a server-selected local Evidence Pack.
# It never calculates a hexagram or selects classical evidence; Python remains
# the deterministic calculation engine. Keep the key server-only (no NEXT_PUBLIC_).
# API root or a complete /chat/completions endpoint are both accepted.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_server_side_key
# LLM_MODEL=gpt-4.1-mini
# Optional request controls for the divination explanation layer.
# LLM_TIMEOUT_MS=60000
# Compatible reasoning models can keep hidden reasoning off for UI-bound paraphrases.
# LLM_DISABLE_THINKING=true
# Local Ollama example used by the Guanyin explanation layer:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
# Optional for compatible reasoning models, for example local Qwen through Ollama.
# LLM_REASONING_EFFORT=none
# LLM_TIMEOUT_SECONDS=120
#
# Hosted API instead of a local model: the same variables, pointing at the
# vendor. Set them on both processes (Next.js and Module 4). A vendor that
# rejects `reasoning_effort` or `enable_thinking` needs those switched off —
# see fortune_module4/docs/deployment_modes.md, "Model Behind A Hosted API".
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=qwen-plus
# LLM_REASONING_EFFORT=
# LLM_DISABLE_THINKING=false

# Server-only Module 4 API used for authentication and private user data.
# Do not expose this internal service URL through NEXT_PUBLIC_ variables.
MODULE4_API_BASE_URL=http://127.0.0.1:8003
# The unified dev script (npm run dev) starts Module 4 on 8001, and
# fortune_module4/scripts/start_api.sh defaults to 8000.
