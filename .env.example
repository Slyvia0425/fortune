# Optional Python/FastAPI algorithm service.
# Leave unset to use clearly marked mock results.
# PYTHON_ALGORITHM_BASE_URL=http://127.0.0.1:8000

# Optional OpenAI-compatible LLM used to understand natural-language
# divination requests and paraphrase a server-selected local Evidence Pack.
# It never calculates a hexagram or selects classical evidence; Python remains
# the deterministic calculation engine. Keep the key server-only (no NEXT_PUBLIC_).
# API root or a complete /chat/completions endpoint are both accepted.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_server_side_key
# LLM_MODEL=gpt-4.1-mini
# Optional request controls for the divination explanation layer.
# LLM_TIMEOUT_MS=60000
# Compatible reasoning models can keep hidden reasoning off for UI-bound paraphrases.
# LLM_DISABLE_THINKING=true
# Local Ollama example used by the Guanyin explanation layer:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
# Optional for compatible reasoning models, for example local Qwen through Ollama.
# LLM_REASONING_EFFORT=none
# LLM_TIMEOUT_SECONDS=120

# Server-only Module 4 API used for authentication and private user data.
# Do not expose this internal service URL through NEXT_PUBLIC_ variables.
# The unified dev script (npm run dev) starts Module 4 on 8001.
# MODULE4_API_BASE_URL=http://127.0.0.1:8001
MODULE4_API_BASE_URL=http://127.0.0.1:8000
