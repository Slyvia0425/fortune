# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# source archives are kept locally; the extracted, versioned data lives in /data
/knowledge_sources_complete*.zip

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python bytecode
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
.venv/
venv/
# local all-in-one runtime created by scripts/setup-local.sh
/.runtime/

# local user data and generated exports
/storage/
/exports/
/uploads/
*.db
*.sqlite
*.sqlite3
*.log

.idea/
