# Per-machine settings. Copy to .env.local and fill in what you need:
#
#   cp .env.local.example .env.local
#   # then put the key in .env.local and restart: bash scripts/start-local.sh
#
# `.env*` is ignored by git, so nothing in this file reaches the repository.
# scripts/start-local.sh loads it and hands the model settings to both
# processes; the shell environment still wins when a variable is already set.
#
# --- A hosted API instead of the local model ------------------------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=
# LLM_MODEL=qwen-plus
# Vendors that reject unknown request fields need these two switched off:
# LLM_REASONING_EFFORT=
# LLM_DISABLE_THINKING=false
#
# --- Local Ollama (the default when nothing is set) -----------------------
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3.8:27b-q8_0
#
# --- Ports and data location ---------------------------------------------
# FRONTEND_PORT=3000
# ALGORITHM_PORT=8000
# MODULE4_PORT=8003
# FORTUNE_DATA_DIR=${HOME}/Documents/Codex/fortune-data
