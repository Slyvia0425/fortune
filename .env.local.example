# Fortune System local configuration template
#
# Copy before starting: cp .env.local.example .env.local
# Never put a real key in this example. `.env.local` is ignored by Git.
# Restart `npm run dev` after changing server-side variables.

# --- Language model: local Ollama (default example) -----------------------
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
LLM_REASONING_EFFORT=none
LLM_DISABLE_THINKING=true
LLM_TIMEOUT_SECONDS=120
# Divination uses milliseconds; Guanyin and BaZi use the seconds value above.
LLM_TIMEOUT_MS=120000

# Hosted OpenAI-compatible API alternative. Comment out the Ollama values and
# uncomment/fill these. Never commit the resulting `.env.local`.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-provider.example.com/v1
# LLM_API_KEY=replace-with-your-private-key
# LLM_MODEL=your-model-name
# LLM_REASONING_EFFORT=
# LLM_DISABLE_THINKING=false

# --- Local services -------------------------------------------------------
# `npm run dev` starts web 3000, algorithms 8000 and Module 4 API 8001.
PYTHON_ALGORITHM_BASE_URL=http://127.0.0.1:8000
# Optional engine-specific overrides; otherwise the shared URL is used.
# PYTHON_BAZI_BASE_URL=http://127.0.0.1:8000
# PYTHON_DIVINATION_BASE_URL=http://127.0.0.1:8000
MODULE4_API_BASE_URL=http://127.0.0.1:8001

# `npm run dev:all` port and persistent-data settings. Its Module 4 default is
# 8003. Shell-style ${HOME} expansion works because start-local.sh sources it.
# FRONTEND_PORT=3000
# ALGORITHM_PORT=8000
# MODULE4_PORT=8003
# FORTUNE_DATA_DIR=${HOME}/Documents/Codex/fortune-data
# FORTUNE_RUNTIME_DIR=${HOME}/Documents/Codex/fortune-runtime
# FORTUNE_VENV_ROOT=${HOME}/Documents/Codex/fortune-runtime/venvs

# Stack verification URLs.
# FORTUNE_FRONTEND_URL=http://127.0.0.1:3000
# FORTUNE_ALGORITHM_URL=http://127.0.0.1:8000
# FORTUNE_MODULE4_URL=http://127.0.0.1:8001

# --- Authentication and internal service security ------------------------
# Keep false for local HTTP; use true in production behind HTTPS.
FORTUNE_COOKIE_SECURE=false
# Generate a long random value for deployed internal requests.
# DIVINATION_INTERNAL_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_MODULE4_USER_ID=dev-user

# --- Divination reasoning -------------------------------------------------
LIUYAO_REASONING_MODE=full
LIUYAO_PLANNER_MODE=deterministic
# Legacy evaluation values include v1, pr4 and pr5; blank uses the current flow.
LIUYAO_RETRIEVAL_PIPELINE=
LIUYAO_CASE_TRACE=true

# --- BaZi reading ---------------------------------------------------------
# When limited, the reading falls back to deterministic template text.
BAZI_READING_LIMIT=12
BAZI_READING_WINDOW_SECONDS=600
# FATEMATCH_KNOWLEDGE_PAGES=/absolute/path/to/knowledge-pages

# --- Module 4 API ---------------------------------------------------------
# Mainly used by dev:all or a standalone Module 4 deployment. For `npm run
# dev`, Module 4 also reads fortune_module4/.env.
ENVIRONMENT=development
MODULE4_DEBUG=true
API_PREFIX=/api/v1
# DATABASE_URL=sqlite:///./module4.db
AUTO_CREATE_TABLES=true
DEV_USER_ID=dev-user
REQUIRE_USER_HEADER=false
ALLOW_LEGACY_USER_HEADER=true
AUTH_SESSION_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CASE_SIMILARITY_THRESHOLD=0.60
# RECOMMENDATION_WEIGHTS_JSON={}

# Production baseline: ENVIRONMENT=production, MODULE4_DEBUG=false,
# AUTO_CREATE_TABLES=false, REQUIRE_USER_HEADER=true,
# ALLOW_LEGACY_USER_HEADER=false, and run `alembic upgrade heads` explicitly.

# --- Module 4 embeddings --------------------------------------------------
# Hash embeddings need no download or external account.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# OpenAI-compatible embeddings (optional).
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_BASE_URL=https://your-provider.example.com/v1
# OPENAI_EMBEDDING_API_KEY=replace-with-your-private-key
# OPENAI_EMBEDDING_MODEL=text-embedding-model-name
# OPENAI_EMBEDDING_BATCH_SIZE=20

# DashScope embeddings (optional alternative).
# EMBEDDING_PROVIDER=dashscope
# DASHSCOPE_API_KEY=replace-with-your-private-key
# DASHSCOPE_WORKSPACE_ID=
# DASHSCOPE_REGION=cn-beijing

# --- Explicit evaluation/test controls; normally leave commented ---------
# FORTUNE_TEST_URL=http://127.0.0.1:3000
# FORTUNE_OUTPUT=/absolute/path/to/evaluation-output
# FORTUNE_CONFIRM_TEST=1
# FORTUNE_REPLAY=1
# FORTUNE_COMPARE=1
# DEMO_USER_ID=demo-user
# DEMO_PEER_ID=demo-peer
# MODULE4_BASE_URL=http://127.0.0.1:8001
# MODULE4_VERIFY_TIMEOUT=600
