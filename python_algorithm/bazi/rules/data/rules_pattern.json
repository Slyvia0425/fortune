{
 "rules": [
  {
   "rule_id": "R-GEJU-00",
   "group": "pattern",
   "condition": "格局由日干配月令地支而定",
   "conclusion": "普通格局以月令为本",
   "when": {},
   "then": {},
   "derived": false,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/010/",
   "chapter": "论用神",
   "quotation": "八字用神,专求月令,以日干配月令地支,而生克不同,格局分焉"
  },
  {
   "rule_id": "R-GEJU-01",
   "group": "pattern",
   "condition": "月令地支所藏之神透于天干",
   "conclusion": "取该透出之神定格",
   "when": {
    "step": "revealed_stem_of_month_branch"
   },
   "then": {
    "pick": "revealed"
   },
   "derived": false,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/018/",
   "chapter": "论杂气如何取用",
   "quotation": "何谓透干?如甲生辰月,透戊则用偏财,透癸则用正印,透乙则用月劫是也"
  },
  {
   "rule_id": "R-GEJU-02",
   "group": "pattern",
   "condition": "月令所藏之神兼透",
   "conclusion": "兼透则兼用",
   "when": {
    "step": "several_revealed"
   },
   "then": {
    "pick": "all_revealed"
   },
   "derived": false,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/018/",
   "chapter": "论杂气如何取用",
   "quotation": "一透则一用,兼透则兼用,透而又会,则透与会并用"
  },
  {
   "rule_id": "R-GEJU-03",
   "group": "pattern",
   "condition": "兼透而需只标一个格局名",
   "conclusion": "按本气、中气、余气的次序取最先透出者为主格，其余并列为兼格",
   "when": {
    "step": "tie_break",
    "order": [
     "primary",
     "middle",
     "residual"
    ]
   },
   "then": {
    "pick": "deepest_revealed"
   },
   "derived": true,
   "note": "典籍只说兼透兼用，未定先后；标签取主格的次序属形式化，其余透出者仍在依据中列出"
  },
  {
   "rule_id": "R-GEJU-04",
   "group": "pattern",
   "condition": "月令所藏之神均不透干",
   "conclusion": "取月令本气之神定格",
   "when": {
    "step": "none_revealed"
   },
   "then": {
    "pick": "primary"
   },
   "derived": true,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/010/",
   "chapter": "论用神",
   "quotation": "取用神之法,先求之于月令之神,月令者当旺之气也",
   "note": "典籍言取用先求月令当旺之气；「不透则取本气」为本项目对取格步骤的形式化。（杂气辰戌丑未不透不会者，徐注言「仅以土论」，同样落到本气）"
  },
  {
   "rule_id": "R-GEJU-ZG",
   "group": "pattern_label",
   "condition": "取格之神的十神为direct_officer",
   "conclusion": "正官格",
   "when": {
    "ten_god_in": [
     "direct_officer"
    ]
   },
   "then": {
    "label": "正官格",
    "key": "zg"
   },
   "derived": false,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/033/",
   "chapter": "论正官",
   "quotation": "正官者分所当尊,如在国有君,在家有亲"
  },
  {
   "rule_id": "R-GEJU-QS",
   "group": "pattern_label",
   "condition": "取格之神的十神为seven_killings",
   "conclusion": "七杀格（偏官格）",
   "when": {
    "ten_god_in": [
     "seven_killings"
    ]
   },
   "then": {
    "label": "七杀格（偏官格）",
    "key": "qs"
   },
   "derived": false,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/041/",
   "chapter": "论偏官",
   "quotation": "煞以攻身,似非美物,而大贵之格,多存七煞"
  },
  {
   "rule_id": "R-GEJU-CA",
   "group": "pattern_label",
   "condition": "取格之神的十神为direct_wealth、indirect_wealth",
   "conclusion": "财格",
   "when": {
    "ten_god_in": [
     "direct_wealth",
     "indirect_wealth"
    ]
   },
   "then": {
    "label": "财格",
    "key": "ca"
   },
   "derived": false,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/035/",
   "chapter": "论财",
   "quotation": "财为我克,使用之物也,以能生官,所以为美"
  },
  {
   "rule_id": "R-GEJU-YS",
   "group": "pattern_label",
   "condition": "取格之神的十神为direct_resource、indirect_resource",
   "conclusion": "印绶格",
   "when": {
    "ten_god_in": [
     "direct_resource",
     "indirect_resource"
    ]
   },
   "then": {
    "label": "印绶格",
    "key": "ys"
   },
   "derived": false,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/037/",
   "chapter": "论印绶",
   "quotation": "印绶喜其生身,正偏同为美格"
  },
  {
   "rule_id": "R-GEJU-SS",
   "group": "pattern_label",
   "condition": "取格之神的十神为eating_god",
   "conclusion": "食神格",
   "when": {
    "ten_god_in": [
     "eating_god"
    ]
   },
   "then": {
    "label": "食神格",
    "key": "ss"
   },
   "derived": false,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/039/",
   "chapter": "论食神",
   "quotation": "食神本属泄气,以其能生正财,所以喜之"
  },
  {
   "rule_id": "R-GEJU-SG",
   "group": "pattern_label",
   "condition": "取格之神的十神为hurting_officer",
   "conclusion": "伤官格",
   "when": {
    "ten_god_in": [
     "hurting_officer"
    ]
   },
   "then": {
    "label": "伤官格",
    "key": "sg"
   },
   "derived": false,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/043/",
   "chapter": "论伤官",
   "quotation": "伤官虽非吉神,实为秀气"
  },
  {
   "rule_id": "R-GEJU-CA-02",
   "group": "pattern",
   "condition": "财与印不分偏正",
   "conclusion": "正财、偏财同为财格；正印、偏印同为印绶格",
   "when": {
    "merge": [
     "wealth",
     "resource"
    ]
   },
   "then": {},
   "derived": false,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/037/",
   "chapter": "论印绶",
   "quotation": "财与印不分偏正,同为一格而论之"
  },
  {
   "rule_id": "R-GEJU-YR",
   "group": "pattern_label",
   "condition": "取格之神为日主的比劫，且月令本气为日主禄前一位（五阳）",
   "conclusion": "阳刃格",
   "when": {
    "ten_god_in": [
     "friend",
     "rob_wealth"
    ],
    "month_primary_is": "yangren"
   },
   "then": {
    "label": "阳刃格",
    "key": "yr"
   },
   "derived": false,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/045/",
   "chapter": "论阳刃",
   "quotation": "禄前一位,惟五阳有之,故为阳刃"
  },
  {
   "rule_id": "R-GEJU-JL",
   "group": "pattern_label",
   "condition": "取格之神为日主的比劫，且月令本气为日主之禄，或阴干月令逢劫",
   "conclusion": "建禄月劫格",
   "when": {
    "ten_god_in": [
     "friend",
     "rob_wealth"
    ],
    "month_primary_is": "lu_or_jie"
   },
   "then": {
    "label": "建禄月劫格",
    "key": "jl"
   },
   "derived": false,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/047/",
   "chapter": "论建禄月劫",
   "quotation": "故建禄与月劫,可同一格,不必加分"
  },
  {
   "rule_id": "R-GEJU-LU",
   "group": "pattern",
   "condition": "十干之禄所在的地支，及五阳之刃（禄前一位）",
   "conclusion": "甲禄寅、乙禄卯、丙戊禄巳、丁己禄午、庚禄申、辛禄酉、壬禄亥、癸禄子；甲刃卯、丙戊刃午、庚刃酉、壬刃子",
   "when": {},
   "then": {
    "lu": {
     "jia": "yin",
     "yi": "mao",
     "bing": "si",
     "wu": "si",
     "ding": "wu_branch",
     "ji": "wu_branch",
     "geng": "shen",
     "xin": "you",
     "ren": "hai",
     "gui": "zi"
    },
    "yangren": {
     "jia": "mao",
     "bing": "wu_branch",
     "wu": "wu_branch",
     "geng": "you",
     "ren": "zi"
    }
   },
   "derived": true,
   "source_id": "sanming-tonghui",
   "kb_url": "https://ctext.org/wiki.pl?if=en&chapter=726272",
   "chapter": "論陽刃 前論羊刃煞與此參看",
   "quotation": "惟甲丙戊庚壬五陽乾有刃,乙丁己辛癸五陰乾無刃,故曰陽刃",
   "note": "阳刃（禄前一位，仅五阳有）见引文；十干之禄所在取通行的十干禄表（语料中仅有「甲禄在寅」一例），故标为形式化"
  }
 ]
}