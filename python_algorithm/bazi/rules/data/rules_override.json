{
 "rules": [
  {
   "rule_id": "R-ZHUANWANG-01",
   "group": "special_pattern",
   "condition": "日主五行的三合局或三会方在四支中齐全（土：辰戌丑未至少三个），且日主五行占比不低于 5/8",
   "conclusion": "专旺格（dominant_element）：顺其气势取用，不再用扶抑",
   "when": {
    "pattern": "dominant_element",
    "day_master_complete_set": true,
    "day_master_element_share_min": 0.625
   },
   "then": {
    "pattern": "dominant_element",
    "final_strength": "very_strong"
   },
   "derived": true,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/010/",
   "chapter": "论用神",
   "quotation": "四柱之气势,偏于一方其势不可逆,惟有顺其气势为用,或从或化,及一方专旺等格局皆是也",
   "note": "成格的结构条件取自《渊海子平》的格局歌诀（见 R-BRANCHSET-*）；「占比不低于 5/8」把评注所说「方局不全者,只要气势专一」一并收紧为『占大半』，是本项目形式化，依调优组案例（8 个标注中 4 个符合、7/310 个盘被检出）取定，检验组未参与。已知不足：方局不全的专旺案例（如 DT-326 炎上缺戌）检不出。；与两气成象不会同时成立（专旺要求日主五行至少 5/8，两气成象要求两种五行各 4/8），所以不设先后"
  },
  {
   "rule_id": "R-ZHUANWANG-02",
   "group": "special_pattern",
   "condition": "五行一方秀气（如甲乙全亥卯未、寅卯辰又生春月）",
   "conclusion": "专旺格取格依据之一",
   "when": {
    "pattern": "dominant_element",
    "example": "曲直"
   },
   "then": {
    "pattern": "dominant_element"
   },
   "derived": false,
   "source_id": "ziping-zhenquan",
   "kb_url": "https://luckclub.cn/bazi/002/049/",
   "chapter": "论杂格",
   "quotation": "有取五行一方秀气者,取甲乙全亥卯未、寅卯辰,又生春月之类"
  },
  {
   "rule_id": "R-LIANGQI-01",
   "group": "special_pattern",
   "condition": "两种五行各占一半，其余五行缺",
   "conclusion": "两气成象（dual_qi_formation）：日主去生，取食伤秀气；情形见 R-LIANGQI-YS-*",
   "when": {
    "pattern": "dual_qi_formation",
    "two_elements_share_min": 1.0,
    "each_share_min": 0.5
   },
   "then": {
    "pattern": "dual_qi_formation",
    "final_strength": null
   },
   "derived": true,
   "source_id": "ditiansui-chanwei",
   "kb_url": "https://ctext.org/wiki.pl?if=en&chapter=126492",
   "chapter": "滴天髓闡微 · 第1部分",
   "quotation": "此造木火各半,兩氣成象",
   "note": "《滴天髓》举例皆为「X Y 各半」且其余五行不见；不要求两五行相生，因为「土水相克,两氣成象」「水土各半,兩氣成象」同样是两气成象。各占 4/8 取自例子，是本项目形式化（调优组 3 个标注全部符合）。"
  },
  {
   "rule_id": "R-OVERRIDE-01",
   "group": "special_pattern",
   "condition": "特殊格局成立时",
   "conclusion": "推翻扶抑的常规强弱结论，改按格局取用神，并记录触发理由与被排除的候选格局",
   "when": {
    "nonmonotonic": true
   },
   "then": {
    "override": true
   },
   "derived": true,
   "note": "proposal v4 第二节：非单调推翻"
  },
  {
   "rule_id": "R-SCOPE-01",
   "group": "special_scope",
   "condition": "本模块实现哪些特殊格局",
   "conclusion": "只实现两种：专旺格（含曲直、炎上、稼穑、从革、润下）与两气成象；其余格局暂不实现",
   "when": {
    "supported": [
     "dominant_element",
     "dual_qi_formation"
    ],
    "deferred": [
     "从财格、从官杀格（原籍成格条件严格——日主无根、四柱无比肩印绶，而注家称为从的案例多带微根或印比，即「假从」；识别不可靠）",
     "化气格（合化真假的判定机制不同）",
     "从儿格（契约暂无此项）",
     "倒冲、朝阳、井栏叉、遥合、合禄等杂格（实例零星，徐乐吾本人亦称其中多数无理）"
    ]
   },
   "then": {},
   "derived": true,
   "note": "10-08 由四种收窄为两种（用户决定）：这两种在原籍里各有自己的取用神办法，识别条件也最清楚；从财、从官杀、化气、从儿、倒冲等只登记，评估时单独列出，不计入召回分母。"
  },
  {
   "rule_id": "R-SHARE-01",
   "group": "share_definition",
   "condition": "五行在命盘中的占比",
   "conclusion": "占比 = 八个字（四天干，四地支各按本气）中属该五行的个数 ÷ 8",
   "when": {},
   "then": {
    "slots": 8,
    "branch": "primary"
   },
   "derived": true,
   "note": "特殊格局的各个占比阈值（0.5、0.75、0.25）都是这个占比的分数，取值与 1.1 的 element_distribution（八字计数）一致；典籍未给量化办法，属本项目形式化，不参与调优"
  },
